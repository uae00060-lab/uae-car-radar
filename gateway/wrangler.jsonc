{
  "name": "car-radar-gateway",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "car-radar-auth",
      "database_id": "2337fbb6-f943-4405-8e40-075d594a50d8"
    }
  ]
}
